 <class>CommentCard</class>
 <widget class="QFrame" name="commentCard">
  <property name="minimumSize"><size><width>0</width><height>112</height></size></property>
  <property name="frameShape"><enum>QFrame::Shape::NoFrame</enum></property>
  <property name="styleSheet"><string notr="true">
QFrame#commentCard{background:#ffffff;border:1px solid #e4e9f0;border-radius:7px;}
QFrame#commentCard:hover{border-color:#cbd7e8;background:#ffffff;}
QLabel#commentAlbumCoverLabel{background:#edf1f6;color:#8a96a7;border:0;border-radius:5px;font-size:11px;}
QLabel#commentAvatarLabel{background:#edf3f5;color:#527080;border:1px solid #d8e2e7;border-radius:22px;font-size:17px;font-weight:800;}
QLabel#commentIndexLabel,QLabel#commentDateLabel,QLabel#commentIdLabel{color:#919cad;font-size:11px;}
QLabel#commentNameLabel{color:#243143;font-size:13px;font-weight:800;}
QLabel#commentLevelLabel,QLabel#commentTitleLabel{color:#597fd3;background:#eef4ff;border-radius:4px;padding:1px 5px;font-size:10px;font-weight:800;}
QLabel#commentContentLabel{color:#344256;font-size:13px;}
QLabel#commentReplyPreviewLabel{color:#7a8799;background:#f6f8fb;border-radius:7px;padding:5px 8px;font-size:11px;}
QLabel#commentLikeLabel{color:#73839b;font-size:12px;}
QPushButton#commentReplyButton{border:0;background:transparent;color:#73839b;padding:2px 5px;font-weight:700;}
QPushButton#commentReplyButton:hover{color:#4f7fe7;background:#f1f5ff;border-radius:5px;}
QPushButton#commentAlbumButton{border:0;background:transparent;color:#263347;padding:0;text-align:left;font-size:13px;font-weight:900;}
QPushButton#commentAlbumButton:hover{color:#4f7fe7;text-decoration:underline;}
  </string></property>
