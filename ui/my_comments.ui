<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MyCommentsHeader</class>
 <widget class="QFrame" name="myCommentsHeader">
  <property name="frameShape"><enum>QFrame::Shape::NoFrame</enum></property>
  <property name="styleSheet"><string notr="true">
QFrame#myCommentsHeader{background:transparent;border:0;}
QLabel#myCommentsTitle{color:#172033;font-size:22px;font-weight:900;}
QLineEdit#myCommentsSearchEdit{min-height:36px;max-height:36px;background:#ffffff;border:1px solid #dfe5ed;border-radius:18px;padding:0 14px;color:#334155;}
QLineEdit#myCommentsSearchEdit:focus{border-color:#7699e9;}
QFrame#myCommentsProfileCard{background:#ffffff;border:1px solid #e5eaf1;border-radius:7px;}
QLabel#myCommentsAvatarLabel{background:#e9eef6;color:#557099;border:1px solid #dce4ef;border-radius:29px;font-size:20px;font-weight:900;}
QLabel#myCommentsNameLabel{color:#1c2638;font-size:16px;font-weight:900;}
QLabel#myCommentsLevelLabel{color:#ffffff;background:#7ea3f3;border-radius:4px;padding:2px 6px;font-size:10px;font-weight:800;}
QLabel#myCommentsBioLabel{color:#7b8798;font-size:12px;}
QPushButton#myCommentsEditProfileButton{min-height:30px;color:#4f7fe7;background:#ffffff;border:1px solid #9bb8f7;border-radius:15px;padding:0 13px;font-weight:700;}
QPushButton#myCommentsEditProfileButton:hover{background:#f3f7ff;}
QFrame#myCommentsDivider{background:#edf0f4;border:0;max-height:1px;}
QLabel[statValue="true"]{color:#27364b;font-size:15px;font-weight:900;}
QLabel[statCaption="true"]{color:#8a96a8;font-size:11px;}
QPushButton[commentFilter="true"]{min-height:34px;background:transparent;border:0;border-bottom:2px solid transparent;color:#667386;padding:0 10px;font-weight:700;}
QPushButton[commentFilter="true"]:hover{color:#4d78dc;}
QPushButton[commentFilter="true"]:checked{color:#3f75e7;border-bottom-color:#3f75e7;}
QComboBox#myCommentsSortCombo{min-height:34px;max-height:34px;min-width:100px;background:#ffffff;border:1px solid #e0e5ec;border-radius:17px;padding:0 28px 0 12px;color:#536174;}
QComboBox#myCommentsSortCombo::drop-down{width:24px;border:0;}
  </string></property>
